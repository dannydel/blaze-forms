@page "/submission/{SubmissionId}"
@rendermode InteractiveServer
@inject IFormDefinitionStore DefinitionStore
@inject SampleSubmissionSink SubmissionSink

<PageTitle>Submission — BlazeForms Sample</PageTitle>

@if (_envelope is null || _version is null)
{
    <p>No submission was found for id "@SubmissionId".</p>
    <p><a href="/fill">Fill the form</a> to create one.</p>
}
else
{
    <h1>Submission received</h1>
    <FormSubmissionView Envelope="_envelope" Version="_version" LatestPublishedVersion="_latestPublishedVersion" />
}

@code {
    /// <summary>
    /// The <c>submissionId</c> route segment, looked up against
    /// <see cref="BlazeForms.Sample.Services.SampleSubmissionSink"/>.
    /// </summary>
    [Parameter]
    public string SubmissionId { get; set; } = "";

    private FormSubmissionEnvelope? _envelope;
    private FormVersion? _version;
    private int? _latestPublishedVersion;

    // Plain reads against the sink and the in-memory store -- safe to run on both the
    // prerendered pass and the reconnected-circuit pass @rendermode InteractiveServer produces.
    protected override async Task OnInitializedAsync()
    {
        _envelope = SubmissionSink.TryGet(SubmissionId);

        if (_envelope is null)
        {
            return;
        }

        // FormSubmissionView always renders against the exact version the submission was
        // captured against (PRD §7) -- never whatever the form's latest version happens to be.
        _version = await DefinitionStore.GetVersionAsync(_envelope.FormId, _envelope.DefinitionVersion);

        var latest = await DefinitionStore.GetLatestPublishedVersionAsync(_envelope.FormId);
        _latestPublishedVersion = latest?.Version;
    }
}
