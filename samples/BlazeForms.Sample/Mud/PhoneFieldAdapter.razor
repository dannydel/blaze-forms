@inherits FormFieldBase
<MudTextField T="string"
              Value="@StringValue"
              ValueChanged="SetStringValueAsync"
              InputType="InputType.Telephone"
              Label="@Node.Label"
              Placeholder="@Node.Placeholder"
              HelperText="@Node.Help"
              Disabled="@Disabled"
              Required="@Node.Required"
              Error="@HasError"
              ErrorText="@Error"
              InputId="@FieldId"
              OnBlur="OnBlurAsync" />
