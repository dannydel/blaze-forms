<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>BlazeForms</RootNamespace>
    <!--
      RS0041 ("public members should not use oblivious types") fires on every component's
      compiler-generated BuildRenderTree override: RazorSourceGenerator emits that method under
      `#nullable restore` regardless of this project's own `<Nullable>enable</Nullable>`. That
      obliviousness is an artifact of Razor codegen, not an actual nullability gap in a
      component's public API (see .editorconfig for the same rationale on the analyzer side);
      NoWarn is required here because RS0041 is reported before analyzer-config severity
      overrides are honored for compiler-generated symbols. Mirrors BlazeForms.Renderer's csproj.
    -->
    <NoWarn>$(NoWarn);RS0041</NoWarn>
    <Description>A keyboard-first, accessible visual designer — FormDesigner and FormLibrary — for authoring and managing versioned BlazeForms definitions.</Description>
  </PropertyGroup>

  <!--
    Public-surface policy (PRD §4.1, §4.4). The contract of this package is FormDesigner and
    FormLibrary. Every other component here — the canvas and its rows, the page tab strip, the
    palette, the properties and rule editors, the linter dock, the preview pane, the dialogs, the
    library card and table — is a building block one of those two composes, as are
    DesignerEditContext, DesignerSelection, DesignerAnnouncement, and their enums, which exist
    only to type those building blocks' [Parameter]s.

    None of them can be made `internal`: the Razor SDK emits every component class as
    `public partial` unconditionally (verified against .NET 10 SDK 10.0.302 — an
    `internal partial` code-behind is CS0262 and there is no MSBuild opt-out), and Blazor
    requires [Parameter] properties to be public, which drags their parameter types public with
    them. So each is instead `sealed` (no inheritance contract, and it keeps every protected
    lifecycle override out of PublicAPI.*.txt) and carries
    [EditorBrowsable(EditorBrowsableState.Never)] so it never surfaces in a consumer's
    completion list. Mirrors BlazeForms.Renderer's csproj.
  -->

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.11" />
    <!-- Abstractions only: FormDesigner and FieldPalette both speak IStringLocalizer<T>
         (PRD §12), but resolve it through Internal/DesignerLocalization.cs's own
         ResourceManager-backed instance, never through DI, so no concrete localization
         provider ships here, and none is required of the host. -->
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazeForms.Core\BlazeForms.Core.csproj" />
    <ProjectReference Include="..\BlazeForms.Renderer\BlazeForms.Renderer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- DesignerStrings and DesignerLocalization are internal by design (PRD §12 remarks on
         Internal/DesignerLocalization.cs), the same as BlazeForms.Renderer's RendererStrings and
         RendererLocalization, and (per CA1812) an internal type with no InternalsVisibleTo
         friend reads as "apparently never instantiated" even though it is; this ItemGroup
         mirrors BlazeForms.Renderer.csproj's own InternalsVisibleTo for that reason as much as
         to let the test project register test doubles and exercise internals directly. -->
    <InternalsVisibleTo Include="BlazeForms.Designer.Tests" />
  </ItemGroup>

</Project>
