<div class="bf-page-tabs">
    <div class="bf-page-tabs__row">
        <nav class="bf-page-tabs__list" aria-label="@Localizer["PageTabStripLabel"].Value">
            @for (var pageIndex = 0; pageIndex < Pages.Count; pageIndex++)
            {
                var page = Pages[pageIndex];
                var title = PageTitle(page, pageIndex);
                @if (IsEditing(page.Id))
                {
                    <input type="text"
                           class="bf-page-tabs__tab-editor"
                           aria-label="@Localizer["PageTabRenameLabel"].Value"
                           @key="page.Id"
                           @ref="_editorElement"
                           @bind="_editingTitle"
                           @bind:event="oninput"
                           @onblur="() => CommitRename(page.Id)"
                           @onkeydown="e => OnEditorKeyDown(e, page.Id)" />
                }
                else
                {
                    // Both the active and non-active button share this one branch -- rather than a
                    // separate branch per state each carrying its own @ref -- because Blazor's diff
                    // builder cannot swap an element that captures a reference for one that does not
                    // under the same @key: it throws trying to remove the old ElementReferenceCapture
                    // frame the instant the active page changes (see this class's own remarks). Every
                    // button therefore captures into TabButtonRefs, keyed by page id, so
                    // OnAfterRenderAsync can still find the specific one to return focus to.
                    <button type="button" class="@TabClass(page.Id)"
                            aria-current="@(IsActiveTab(page.Id) ? "page" : null)"
                            title="@Localizer["PageTabRenameHint"].Value"
                            @key="page.Id" @ref="TabButtonRefs[page.Id]"
                            @onclick="() => SelectPage(page.Id)" @ondblclick="() => BeginRename(page.Id)" @onkeydown="e => OnTabKeyDown(e, page.Id)">
                        @title
                    </button>
                }
            }
        </nav>
        <button type="button" class="bf-page-tabs__add" @onclick="AddPage">
            @Localizer["AddPageButtonLabel"].Value
        </button>
    </div>

    @if (ActivePage is { Sections.Count: 0 })
    {
        <div class="bf-page-tabs__empty">
            <p>@Localizer["EmptyPageText"].Value</p>
            <div class="bf-page-tabs__empty-actions">
                <button type="button" @onclick="AddSection">@Localizer["AddSectionButtonLabel"].Value</button>
                <button type="button" disabled aria-disabled="true">@Localizer["StartFromTemplateButtonLabel"].Value</button>
            </div>
        </div>
    }
</div>
