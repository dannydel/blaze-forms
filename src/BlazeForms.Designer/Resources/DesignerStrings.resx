<?xml version="1.0" encoding="utf-8"?>
<root>
  <xsd:schema id="root" xmlns="" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
    <xsd:import namespace="http://www.w3.org/XML/1998/namespace" />
    <xsd:element name="root" msdata:IsDataSet="true">
      <xsd:complexType>
        <xsd:choice maxOccurs="unbounded">
          <xsd:element name="metadata">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" />
              </xsd:sequence>
              <xsd:attribute name="name" use="required" type="xsd:string" />
              <xsd:attribute name="type" type="xsd:string" />
              <xsd:attribute name="mimetype" type="xsd:string" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="assembly">
            <xsd:complexType>
              <xsd:attribute name="alias" type="xsd:string" />
              <xsd:attribute name="name" type="xsd:string" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="data">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
                <xsd:element name="comment" type="xsd:string" minOccurs="0" msdata:Ordinal="2" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" msdata:Ordinal="1" />
              <xsd:attribute name="type" type="xsd:string" msdata:Ordinal="3" />
              <xsd:attribute name="mimetype" type="xsd:string" msdata:Ordinal="4" />
              <xsd:attribute ref="xml:space" />
            </xsd:complexType>
          </xsd:element>
          <xsd:element name="resheader">
            <xsd:complexType>
              <xsd:sequence>
                <xsd:element name="value" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
              </xsd:sequence>
              <xsd:attribute name="name" type="xsd:string" use="required" />
            </xsd:complexType>
          </xsd:element>
        </xsd:choice>
      </xsd:complexType>
    </xsd:element>
  </xsd:schema>
  <resheader name="resmimetype">
    <value>text/microsoft-resx</value>
  </resheader>
  <resheader name="version">
    <value>2.0</value>
  </resheader>
  <resheader name="reader">
    <value>System.Resources.ResXResourceReader, System.Windows.Forms</value>
  </resheader>
  <resheader name="writer">
    <value>System.Resources.ResXResourceWriter, System.Windows.Forms</value>
  </resheader>

  <!-- The three docked pane titles (PRD §4.1, D9). Also used as each pane's aria-label. -->
  <data name="PaneTitlePalette" xml:space="preserve">
    <value>Field palette</value>
  </data>
  <data name="PaneTitleCanvas" xml:space="preserve">
    <value>Canvas</value>
  </data>
  <data name="PaneTitleProperties" xml:space="preserve">
    <value>Properties</value>
  </data>

  <!-- Shown in PropertiesPanel's own body when nothing is selected (Phase 4, PRD §4.1). -->
  <data name="PropertiesPlaceholderText" xml:space="preserve">
    <value>Select a field on the canvas to edit its properties.</value>
  </data>

  <!-- Fallback name for a brand-new form that has never had a name saved (PRD §5, FormDefinition.Name). -->
  <data name="UntitledFormName" xml:space="preserve">
    <value>Untitled form</value>
  </data>

  <!-- Shown in the canvas pane while the working draft loads or in-memory-creates, deferred out of
       OnInitializedAsync into OnAfterRenderAsync for prerender safety (see FormDesigner's remarks). -->
  <data name="DesignerLoading" xml:space="preserve">
    <value>Loading…</value>
  </data>

  <!-- Field palette chrome (PRD §4.1). -->
  <data name="PaletteSearchLabel" xml:space="preserve">
    <value>Search fields</value>
  </data>
  <data name="PaletteSearchPlaceholder" xml:space="preserve">
    <value>Search fields…</value>
  </data>
  <data name="PalettePhaseBadgeText" xml:space="preserve">
    <value>Phase 2</value>
  </data>

  <!-- Palette group names (PRD §5's node-type table). -->
  <data name="PaletteGroupText" xml:space="preserve">
    <value>Text</value>
  </data>
  <data name="PaletteGroupNumeric" xml:space="preserve">
    <value>Numeric</value>
  </data>
  <data name="PaletteGroupDate" xml:space="preserve">
    <value>Date</value>
  </data>
  <data name="PaletteGroupChoice" xml:space="preserve">
    <value>Choice</value>
  </data>
  <data name="PaletteGroupStatic" xml:space="preserve">
    <value>Static</value>
  </data>
  <data name="PaletteGroupAdvanced" xml:space="preserve">
    <value>Advanced</value>
  </data>

  <!-- Node-type display names, one per PRD §5 P1 type plus the three P2-reserved types. Keyed as
       "NodeType" + the NodeType enum member name so FieldPalette resolves each without a
       per-value switch. -->
  <data name="NodeTypeText" xml:space="preserve">
    <value>Text</value>
  </data>
  <data name="NodeTypeTextArea" xml:space="preserve">
    <value>Text area</value>
  </data>
  <data name="NodeTypeEmail" xml:space="preserve">
    <value>Email</value>
  </data>
  <data name="NodeTypePhone" xml:space="preserve">
    <value>Phone</value>
  </data>
  <data name="NodeTypeNumber" xml:space="preserve">
    <value>Number</value>
  </data>
  <data name="NodeTypeCurrency" xml:space="preserve">
    <value>Currency</value>
  </data>
  <data name="NodeTypeDate" xml:space="preserve">
    <value>Date</value>
  </data>
  <data name="NodeTypeDateRange" xml:space="preserve">
    <value>Date range</value>
  </data>
  <data name="NodeTypeSelect" xml:space="preserve">
    <value>Dropdown</value>
  </data>
  <data name="NodeTypeRadio" xml:space="preserve">
    <value>Radio buttons</value>
  </data>
  <data name="NodeTypeCheckboxGroup" xml:space="preserve">
    <value>Checkbox group</value>
  </data>
  <data name="NodeTypeYesNo" xml:space="preserve">
    <value>Yes/No</value>
  </data>
  <data name="NodeTypeBoolean" xml:space="preserve">
    <value>Checkbox</value>
  </data>
  <data name="NodeTypeHeading" xml:space="preserve">
    <value>Heading</value>
  </data>
  <data name="NodeTypeParagraph" xml:space="preserve">
    <value>Paragraph</value>
  </data>
  <data name="NodeTypeCallout" xml:space="preserve">
    <value>Callout</value>
  </data>
  <data name="NodeTypeDivider" xml:space="preserve">
    <value>Divider</value>
  </data>
  <data name="NodeTypeCalc" xml:space="preserve">
    <value>Calculated value</value>
  </data>
  <data name="NodeTypeRepeating" xml:space="preserve">
    <value>Repeating group</value>
  </data>
  <data name="NodeTypeFile" xml:space="preserve">
    <value>File upload</value>
  </data>
  <data name="NodeTypeLookup" xml:space="preserve">
    <value>Lookup</value>
  </data>

  <!-- Fallback page heading when a FormPage.Title is null, used when building an announcement or
       an undo/redo description that names a page. Mirrors FormRenderer's own
       "PageFallbackTitle" (RendererStrings.resx), kept as its own key here since
       BlazeForms.Designer does not reference BlazeForms.Renderer's resources. -->
  <data name="PageFallbackTitle" xml:space="preserve">
    <value>Page {0}</value>
  </data>

  <!-- Fallback section title when a FormSection.Title is null, used the same way as
       PageFallbackTitle above. -->
  <data name="UntitledSectionName" xml:space="preserve">
    <value>Untitled section</value>
  </data>

  <!-- DesignerEditContext announcement templates (PRD §4.1, §11): every structural mutation
       raises exactly one of these, in plain language, to the aria-live region. Each one also
       becomes that mutation's EditSnapshot.Description, reused verbatim inside
       AnnouncementUndid/AnnouncementRedid so undoing or redoing announces what is actually being
       reversed or reapplied. -->
  <data name="AnnouncementNodeAdded" xml:space="preserve">
    <value>Added {0} to '{1}'.</value>
  </data>
  <data name="AnnouncementNodeUpdated" xml:space="preserve">
    <value>Updated '{0}'.</value>
  </data>
  <data name="AnnouncementNodeDeleted" xml:space="preserve">
    <value>Deleted '{0}'.</value>
  </data>
  <data name="AnnouncementNodeDuplicated" xml:space="preserve">
    <value>Duplicated '{0}'.</value>
  </data>
  <data name="AnnouncementPageAdded" xml:space="preserve">
    <value>Added page {0}.</value>
  </data>
  <data name="AnnouncementSectionAdded" xml:space="preserve">
    <value>Added a section to '{0}'.</value>
  </data>
  <data name="AnnouncementNodeMoved" xml:space="preserve">
    <value>Moved to position {0} of {1} in '{2}'.</value>
  </data>
  <data name="AnnouncementValidationRulesUpdated" xml:space="preserve">
    <value>Updated the form's validation rules.</value>
  </data>
  <data name="AnnouncementUndid" xml:space="preserve">
    <value>Undid: {0}</value>
  </data>
  <data name="AnnouncementRedid" xml:space="preserve">
    <value>Redid: {0}</value>
  </data>

  <!-- Announced when a queued autosave actually fails to persist (PRD §7, §11),
       DesignerEditContext.AutosaveFailed's own message; the author's edit itself is unaffected,
       this just tells them the store write has not happened yet. -->
  <data name="AutosaveFailed" xml:space="preserve">
    <value>Your changes could not be saved. Retrying on your next edit.</value>
  </data>

  <!-- DesignerCanvas (Phase 3, PRD §4.1, §11): the roving-focus, listbox/option-shaped canvas of
       the current page's sections and node rows. -->
  <data name="CanvasRegionLabel" xml:space="preserve">
    <value>Form fields</value>
  </data>
  <data name="CanvasNoPageSelectedText" xml:space="preserve">
    <value>Add a page to start building this form.</value>
  </data>

  <!-- CanvasNodeRow (Phase 3, PRD §4.1): a node row's fallback label and chips. {0} in
       UntitledNodeLabel is the node's localized NodeType{Type} display name (e.g. "Untitled Text"). -->
  <data name="UntitledNodeLabel" xml:space="preserve">
    <value>Untitled {0}</value>
  </data>
  <data name="RowRequiredChip" xml:space="preserve">
    <value>Required</value>
  </data>
  <data name="RowHalfWidthChip" xml:space="preserve">
    <value>Half width</value>
  </data>
  <data name="RowVisibilityRuleChip" xml:space="preserve">
    <value>Has visibility rule</value>
  </data>

  <!-- PageTabStrip (Phase 3, PRD §4.1): the page tablist and its add-page/add-section/empty-page
       affordances. -->
  <data name="PageTabStripLabel" xml:space="preserve">
    <value>Pages</value>
  </data>
  <data name="AddPageButtonLabel" xml:space="preserve">
    <value>Add page</value>
  </data>
  <data name="AddSectionButtonLabel" xml:space="preserve">
    <value>Add blank section</value>
  </data>
  <data name="StartFromTemplateButtonLabel" xml:space="preserve">
    <value>Start from template</value>
  </data>
  <data name="EmptyPageText" xml:space="preserve">
    <value>This page has no sections yet.</value>
  </data>

  <!-- PropertiesPanel (Phase 4, PRD §4.1, §5, §5.1): field labels, hints, and the accessible
       empty-label affordance every property control needs. -->
  <data name="PropFieldIdLabel" xml:space="preserve">
    <value>Field ID</value>
  </data>
  <data name="PropLabelLabel" xml:space="preserve">
    <value>Label</value>
  </data>
  <data name="PropLabelRequiredWarning" xml:space="preserve">
    <value>This field needs a label; a placeholder does not count as one.</value>
  </data>
  <data name="PropHelpLabel" xml:space="preserve">
    <value>Help text</value>
  </data>
  <data name="PropPlaceholderLabel" xml:space="preserve">
    <value>Placeholder</value>
  </data>
  <data name="PropRequiredLabel" xml:space="preserve">
    <value>Required</value>
  </data>
  <data name="PropRequiredWhenVisibleLabel" xml:space="preserve">
    <value>Required only while visible</value>
  </data>
  <data name="PropHalfWidthLabel" xml:space="preserve">
    <value>Half-width</value>
  </data>
  <data name="PropMinLabel" xml:space="preserve">
    <value>Minimum</value>
  </data>
  <data name="PropMaxLabel" xml:space="preserve">
    <value>Maximum</value>
  </data>
  <data name="PropLevelLabel" xml:space="preserve">
    <value>Heading level</value>
  </data>
  <data name="PropLevelOption2" xml:space="preserve">
    <value>Level 2</value>
  </data>
  <data name="PropLevelOption3" xml:space="preserve">
    <value>Level 3</value>
  </data>
  <data name="PropLevelOption4" xml:space="preserve">
    <value>Level 4</value>
  </data>
  <data name="PropContentLabel" xml:space="preserve">
    <value>Content</value>
  </data>
  <data name="PropSupportsMarkdownHint" xml:space="preserve">
    <value>Supports Markdown</value>
  </data>
  <data name="PropVisibilityLabel" xml:space="preserve">
    <value>Visibility</value>
  </data>
  <data name="PropVisibilityAlwaysVisible" xml:space="preserve">
    <value>Always visible.</value>
  </data>
  <data name="PropVisibilityHasRule" xml:space="preserve">
    <value>Has a visibility rule.</value>
  </data>
  <data name="PropVisibilityAddRuleButton" xml:space="preserve">
    <value>Add rule</value>
  </data>
  <data name="PropVisibilityEditRuleButton" xml:space="preserve">
    <value>Edit rule</value>
  </data>
  <data name="PropVisibilityRemoveRuleButton" xml:space="preserve">
    <value>Remove rule</value>
  </data>

  <!-- OptionsEditor (Phase 4, PRD §4.1, §5): the choice-node options row list. Each row's
       stable Value follows the row itself, never its position (AGENTS.md invariant #5), so
       {0} below is always the row's current ordinal, naming the option for a screen reader
       even when its own label is blank (a newly added row) or duplicates a sibling's. -->
  <data name="PropOptionsLabel" xml:space="preserve">
    <value>Options</value>
  </data>
  <data name="PropOptionsRowLabel" xml:space="preserve">
    <value>Option {0} label</value>
  </data>
  <data name="PropOptionsMoveUpButton" xml:space="preserve">
    <value>Move option {0} up</value>
  </data>
  <data name="PropOptionsMoveDownButton" xml:space="preserve">
    <value>Move option {0} down</value>
  </data>
  <data name="PropOptionsRemoveButton" xml:space="preserve">
    <value>Remove option {0}</value>
  </data>
  <data name="PropOptionsMoveUpText" xml:space="preserve">
    <value>Move up</value>
  </data>
  <data name="PropOptionsMoveDownText" xml:space="preserve">
    <value>Move down</value>
  </data>
  <data name="PropOptionsRemoveText" xml:space="preserve">
    <value>Remove</value>
  </data>
  <data name="PropOptionsAddButton" xml:space="preserve">
    <value>Add option</value>
  </data>
</root>
