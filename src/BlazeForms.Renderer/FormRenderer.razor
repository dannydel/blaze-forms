<div class="bf-renderer">
    @if (_isSubmitted && _submittedEnvelope is not null)
    {
        @if (ConfirmationTemplate is not null)
        {
            @ConfirmationTemplate(_submittedEnvelope)
        }
        else
        {
            <div class="bf-confirmation" role="status" tabindex="-1" @ref="_confirmationElement">
                <p>@Localizer["DefaultConfirmationMessage"].Value</p>
            </div>
        }
    }
    else if (CurrentPage is not null)
    {
        <nav class="bf-progress" aria-label="Form progress">
            <ol class="bf-progress__list">
                @for (var pageIndex = 0; pageIndex < Pages.Count; pageIndex++)
                {
                    var page = Pages[pageIndex];
                    var isCurrentStep = pageIndex == _currentPageIndex;
                    <li class="bf-progress__step" aria-current="@(isCurrentStep ? "step" : null)" @key="page.Id">
                        <span class="bf-progress__step-number">@(pageIndex + 1)</span>
                        <span class="bf-progress__step-title">@PageTitleOrFallback(page, pageIndex)</span>
                    </li>
                }
            </ol>
        </nav>

        <div class="bf-visually-hidden" aria-live="polite">@StepAnnouncement</div>
        <div class="bf-visually-hidden bf-calc-announcer" aria-live="polite">@_calcAnnouncement</div>

        <ErrorSummary @ref="_errorSummary" Entries="SummaryEntries" HeadingText="@Localizer["ErrorSummaryHeading"].Value" />

        <section class="bf-page" aria-labelledby="@PageHeadingElementId">
            <h2 id="@PageHeadingElementId" @ref="_pageHeadingElement" tabindex="-1" class="bf-page__title">
                @PageTitleOrFallback(CurrentPage, _currentPageIndex)
            </h2>

            @{ var visibleNodeIds = GetVisibleNodeIds(); }

            @foreach (var section in CurrentPage.Sections)
            {
                // A titled section groups its fields in a fieldset/legend; a title-less one uses a
                // plain div, because a legend-less fieldset is an unnamed "group" node in the
                // accessibility tree — screen-reader noise with no grouping benefit.
                RenderFragment sectionBody =
                    @<text>
                        @if (!string.IsNullOrWhiteSpace(section.Description))
                        {
                            <p class="bf-section__description">@section.Description</p>
                        }
                        <div class="bf-row">
                            @foreach (var node in section.Nodes)
                            {
                                @if (visibleNodeIds.Contains(node.Id))
                                {
                                    <div class="@(node.Half ? "bf-col-half" : "bf-col-full")" @key="node.Id">
                                        <DynamicComponent Type="@ResolveComponentType(node)" Parameters="@BuildFieldParameters(node)" />
                                    </div>
                                }
                            }
                        </div>
                    </text>;

                @if (!string.IsNullOrWhiteSpace(section.Title))
                {
                    <fieldset class="bf-fieldset bf-section" @key="section.Id">
                        <legend class="bf-section__legend">@section.Title</legend>
                        @sectionBody
                    </fieldset>
                }
                else
                {
                    <div class="bf-section" @key="section.Id">
                        @sectionBody
                    </div>
                }
            }
        </section>

        <div class="bf-step-nav">
            <button type="button" class="bf-step-nav__button" disabled="@IsFirstPage" @onclick="GoToPreviousPage">
                @Localizer["PreviousButtonLabel"].Value
            </button>
            @if (IsLastPage)
            {
                <button type="button" class="bf-step-nav__button bf-step-nav__button--primary" @onclick="SubmitAsync">
                    @Localizer["SubmitButtonLabel"].Value
                </button>
            }
            else
            {
                <button type="button" class="bf-step-nav__button" @onclick="GoToNextPage">
                    @Localizer["NextButtonLabel"].Value
                </button>
            }
        </div>
    }
</div>
