@if (Entries.Count > 0)
{
    <div class="bf-error-summary" role="alert" tabindex="-1" @ref="_rootElement">
        <h2 class="bf-error-summary__heading">@HeadingText</h2>
        <ul class="bf-error-summary__list">
            @foreach (var entry in Entries)
            {
                <li @key="entry.FieldDomId">
                    <a href="@($"#{entry.FieldDomId}")">@entry.Message</a>
                </li>
            }
        </ul>
    </div>
}
