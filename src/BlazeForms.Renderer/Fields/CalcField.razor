@inherits FormFieldBase
<div class="bf-field">
    <label for="@FieldId">@Node.Label</label>
    <output id="@FieldId"
            class="bf-field__output"
            aria-live="off"
            aria-describedby="@BuildDescribedBy()">@DisplayText</output>
    @if (HasHelp)
    {
        <div id="@HelpElementId" class="bf-field__help bf-prose">@HelpMarkup</div>
    }
</div>
