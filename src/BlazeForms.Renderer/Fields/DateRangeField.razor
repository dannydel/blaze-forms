@inherits FormFieldBase
@* The fieldset carries the field's own DOM id and tabindex="-1" so an error-summary anchor
   (#FieldId) has somewhere to land (PRD §11, WCAG 2.4.1) -- there is no single role="radiogroup"
   container here to carry it instead, unlike RadioGroupField/YesNoField. *@
<fieldset class="bf-fieldset" id="@FieldId" tabindex="-1" disabled="@Disabled" aria-describedby="@BuildDescribedBy()">
    <legend>@Node.Label</legend>
    <div class="bf-daterange">
        <div class="bf-daterange__part">
            <label for="@StartFieldId">@StartLabel</label>
            <input id="@StartFieldId"
                   type="date"
                   disabled="@Disabled"
                   aria-required="@RequiredAttributeValue"
                   aria-invalid="@InvalidAttributeValue"
                   @bind:get="StartDate"
                   @bind:set="SetStartDateAsync"
                   @onblur="OnBlurAsync" />
        </div>
        <div class="bf-daterange__part">
            <label for="@EndFieldId">@EndLabel</label>
            <input id="@EndFieldId"
                   type="date"
                   disabled="@Disabled"
                   aria-required="@RequiredAttributeValue"
                   aria-invalid="@InvalidAttributeValue"
                   @bind:get="EndDate"
                   @bind:set="SetEndDateAsync"
                   @onblur="OnBlurAsync" />
        </div>
    </div>
    @if (HasHelp)
    {
        <div id="@HelpElementId" class="bf-field__help bf-prose">@HelpMarkup</div>
    }
    @if (HasError)
    {
        <span id="@ErrorElementId" class="bf-field__error">@Error</span>
    }
</fieldset>
