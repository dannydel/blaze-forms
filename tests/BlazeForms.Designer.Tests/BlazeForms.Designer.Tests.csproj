<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="bunit" Version="2.9.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <!-- ChangeEventArgs, for driving the palette search box through InputAsync in the
         render-discipline test (CA1849 requires the async dispatch overload once a test method
         is itself async). -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.12" />
    <!-- Registers InMemoryFormDefinitionStore as a test double via Services.AddSingleton. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BlazeForms.Designer\BlazeForms.Designer.csproj" />
    <!-- DesignerContrastTests and DesignerThemeCssTests reuse WcagContrast and
         CssRootTokenParser from Renderer.Tests rather than duplicating the luminance/parsing
         math, mirroring the source-side dependency (BlazeForms.Designer depends on
         BlazeForms.Renderer, PRD §9). -->
    <ProjectReference Include="..\BlazeForms.Renderer.Tests\BlazeForms.Renderer.Tests.csproj" />
  </ItemGroup>

</Project>